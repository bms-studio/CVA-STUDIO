# ===== CVA STUDIO =====
# Copy file ini ke .env dan sesuaikan

PORT=3000
APP_URL=http://localhost:3000

# ===== KEAMANAN =====
# WAJIB GANTI: random string panjang. Dipakai untuk JWT sesi + enkripsi API key Roblox.
JWT_SECRET=ganti-dengan-random-string-panjang-5214

# ===== 4) UPLOAD ROBLOX (tidak ada env — dilakukan di UI) =====
# Di dashboard -> tab "Roblox API Keys" -> Add Key:
#   1. Buka https://create.roblox.com -> Creator Dashboard -> Open Cloud -> API Keys -> Create
#   2. Pilih scope: Universe (atau Group) milik Anda
#   3. Centang permission: Asset Upload (asset:write), Asset Read (asset:read),
#      Asset Manage (asset:manage), dan untuk fitur Bulk Permissions: Experience Read
#   4. Salin secret (hanya tampil sekali), paste ke kolom "API Key Secret"
#   5. "Creator Type" = User/Group sesuai scope key; "Creator ID" = userId/groupId milik Anda
#   6. Klik "Test Key" untuk verifikasi end-to-end (upload audio senyap lalu arsipkan)

# ===== 5) BINARY TOOLS =====
# YTDLP_CMD=python -m yt_dlp
# FFMPEG_CMD=ffmpeg
# FFPROBE_CMD=ffprobe

# ===== 6) YOUTUBE ANTI-BOT (opsional) =====
# Error "HTTP Error 403: Forbidden" saat unduh = YouTube memblokir sesi aplikasi
# pada video populer/baru. Solusi: cookies browser yang sudah login YouTube.
# YTDLP_COOKIES_BROWSER=firefox        # pilihan: firefox | chrome | edge
# YTDLP_EXTRA_ARGS=--retries 3

# Webhook Discord untuk monitoring (bug/spam/lokasi user) - opsional, kosongkan untuk mati
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WEBHOOK_SPAM_THRESHOLD=15
